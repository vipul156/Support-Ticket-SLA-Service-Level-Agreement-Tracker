generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REPORTER
  AGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(REPORTER)
  createdAt       DateTime  @default(now())
  reportedTickets Ticket[]  @relation("ReporterToTicket")
  assignedTickets Ticket[]  @relation("AssigneeToTicket")
  comments        Comment[]

  @@index([role])
}

model Ticket {
  id                 Int          @id @default(autoincrement())
  title              String
  description        String
  priority           Priority
  status             TicketStatus @default(OPEN)
  reporterId         Int
  assigneeId         Int?
  createdAt          DateTime     @default(now())
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  reporter           User         @relation("ReporterToTicket", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee           User?        @relation("AssigneeToTicket", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments           Comment[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([status, priority])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  authorId  Int
  ticketId  Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  name      String
  createdAt DateTime @default(now())

  @@index([date])
}
